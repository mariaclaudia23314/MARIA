{% comment %}Inkcora — sections/main-product.liquid — Product Personalizer{% endcomment %}
{%- liquid
  assign color_option = product.options_by_name['Color'] | default: product.options_by_name['Colour']
  assign size_option  = product.options_by_name['Size']
-%}
<div style="background:#fff;border-bottom:1px solid var(--color-border)">
  <div class="page-width" style="padding:0.875rem 0;font-size:0.8125rem">
    <a href="{{ routes.root_url }}" style="color:var(--color-primary);text-decoration:none">Home</a>
    <span style="color:var(--color-text-muted);margin:0 0.4rem">›</span>
    <a href="{{ routes.all_products_collection_url }}" style="color:var(--color-primary);text-decoration:none">Shop</a>
    <span style="color:var(--color-text-muted);margin:0 0.4rem">›</span>
    <span style="color:var(--color-text-muted)">{{ product.title }}</span>
  </div>
</div>
<section id="MainProduct-{{ section.id }}" style="background:#fff;padding:1.5rem 0 4rem">
  <div class="page-width">
    <div style="display:grid;grid-template-columns:1fr 400px;gap:2.5rem;align-items:start">

      <!-- LEFT: Canvas -->
      <div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
          <div style="display:flex;border:1px solid var(--color-border);border-radius:var(--radius-button);overflow:hidden">
            <button id="btn-front" onclick="inkView('front')" style="padding:0.5rem 1.25rem;font-size:0.6875rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;border:none;cursor:pointer;background:var(--color-navy);color:#fff">FRONT VIEW</button>
            <button id="btn-back"  onclick="inkView('back')"  style="padding:0.5rem 1.25rem;font-size:0.6875rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;border:none;cursor:pointer;background:#fff;color:var(--color-text-muted)">BACK VIEW</button>
          </div>
          <span style="font-size:0.75rem;color:#4caf50;display:flex;align-items:center;gap:0.375rem"><span style="width:7px;height:7px;border-radius:50%;background:#4caf50;display:inline-block"></span>Safe area</span>
        </div>
        <div style="display:flex;border:1px solid var(--color-border);border-radius:var(--radius-card);overflow:hidden;background:var(--color-background-secondary)">
          <!-- Toolbar -->
          <div style="width:68px;background:#f3f2ef;border-right:1px solid var(--color-border);display:flex;flex-direction:column;align-items:center;padding:1rem 0;gap:0.5rem;flex-shrink:0">
            <label title="Upload" style="display:flex;flex-direction:column;align-items:center;gap:0.25rem;cursor:pointer;padding:0.625rem 0.5rem;border-radius:6px;width:100%">
              <input type="file" id="ink-upload" accept="image/*" style="display:none" onchange="inkHandleUpload(this)">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 13V4M6 8l4-4 4 4" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><rect x="2" y="15" width="16" height="3" rx="1" stroke="var(--color-text-muted)" stroke-width="1.2"/></svg>
              <span style="font-size:0.5rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted)">Upload</span>
            </label>
            <button onclick="inkAddText()" style="display:flex;flex-direction:column;align-items:center;gap:0.25rem;padding:0.625rem 0.5rem;border-radius:6px;width:100%;background:none;border:none;cursor:pointer">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 4h14M10 4v13M7 17h6" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-linecap="round"/></svg>
              <span style="font-size:0.5rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted)">Text</span>
            </button>
            <button onclick="inkToggleColor()" style="display:flex;flex-direction:column;align-items:center;gap:0.25rem;padding:0.625rem 0.5rem;border-radius:6px;width:100%;background:none;border:none;cursor:pointer">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="var(--color-text-muted)" stroke-width="1.5"/><circle cx="10" cy="10" r="3.5" fill="var(--color-primary)" opacity="0.7"/></svg>
              <span style="font-size:0.5rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted)">Color</span>
            </button>
            <div style="height:1px;background:var(--color-border);width:75%;margin:0.25rem auto"></div>
            <button onclick="inkUndo()" style="padding:0.5rem;background:none;border:none;cursor:pointer;display:flex;justify-content:center"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9a6 6 0 106 6" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-linecap="round"/><path d="M3 5v4h4" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <button onclick="inkRedo()" style="padding:0.5rem;background:none;border:none;cursor:pointer;display:flex;justify-content:center"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M15 9a6 6 0 11-6 6" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-linecap="round"/><path d="M15 5v4h-4" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </div>
          <!-- Canvas -->
          <div style="flex:1;position:relative;min-height:500px;display:flex;align-items:center;justify-content:center;overflow:hidden">
            {%- if product.featured_image -%}
              <img id="ink-img" src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title }}" style="max-height:480px;max-width:100%;object-fit:contain;display:block">
            {%- else -%}
              <div id="ink-img" style="width:280px;height:340px;background:#d9d4cc;border-radius:4px;display:flex;align-items:center;justify-content:center"><span style="color:#999;font-size:0.875rem">Product image</span></div>
            {%- endif -%}
            <div style="position:absolute;top:12%;left:22%;right:22%;bottom:10%;border:1.5px dashed rgba(255,165,0,0.55);pointer-events:none"></div>
            <div id="ink-prompt" style="position:absolute;bottom:28%;left:50%;transform:translateX(-50%);background:rgba(255,255,255,0.9);border:1.5px dashed var(--color-primary);padding:0.5rem 1.5rem;border-radius:20px;font-size:0.8125rem;color:var(--color-text-muted);white-space:nowrap;pointer-events:none">Upload your logo or add text</div>
            <span id="ink-text-disp" style="position:absolute;font-size:1.5rem;font-weight:700;color:#fff;text-shadow:0 1px 4px rgba(0,0,0,0.5);display:none;pointer-events:none"></span>
            <div id="ink-text-popup" style="display:none;position:absolute;inset:0;background:rgba(0,0,0,0.25);align-items:center;justify-content:center">
              <div style="background:#fff;padding:1.5rem;border-radius:8px;width:280px">
                <div style="font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.75rem;color:var(--color-navy)">Add text to design</div>
                <input id="ink-text-inp" type="text" placeholder="Your text here…" style="width:100%;padding:0.625rem 0.875rem;border:1px solid var(--color-border);border-radius:4px;font-size:1rem;font-family:inherit;margin-bottom:0.75rem;box-sizing:border-box">
                <div style="display:flex;gap:0.5rem">
                  <button onclick="inkConfirmText()" style="flex:1;padding:0.625rem;background:var(--color-primary);color:#fff;border:none;border-radius:4px;font-weight:700;font-size:0.8125rem;cursor:pointer">Apply</button>
                  <button onclick="document.getElementById('ink-text-popup').style.display='none'" style="flex:1;padding:0.625rem;background:#fff;color:var(--color-text-muted);border:1px solid var(--color-border);border-radius:4px;font-size:0.8125rem;cursor:pointer">Cancel</button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:0.875rem">
          <button onclick="inkClear()" style="padding:0.75rem;border:1px solid var(--color-border);background:#fff;font-size:0.6875rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);cursor:pointer;border-radius:var(--radius-button)">CLEAR</button>
          <button onclick="inkDownload()" style="padding:0.75rem;border:1px solid var(--color-border);background:#fff;font-size:0.6875rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);cursor:pointer;border-radius:var(--radius-button)">DOWNLOAD PREVIEW</button>
        </div>
        <!-- Views -->
        <div style="margin-top:1.5rem">
          <div style="font-size:0.6rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.75rem">VIEWS</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
            <div id="vf" onclick="inkView('front')" style="border:2px solid var(--color-primary);border-radius:var(--radius-card);cursor:pointer;background:var(--color-background-secondary);overflow:hidden">
              <div style="aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;padding:0.75rem">{%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 300 }}" alt="Front" style="max-height:100%;max-width:100%;object-fit:contain">{%- else -%}<span style="color:var(--color-text-muted);font-size:0.75rem;font-style:italic">Front</span>{%- endif -%}</div>
              <div style="padding:0.4rem;text-align:center;font-size:0.5625rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-text-muted);border-top:1px solid var(--color-border)">FRONT</div>
            </div>
            <div id="vb" onclick="inkView('back')" style="border:1px solid var(--color-border);border-radius:var(--radius-card);cursor:pointer;background:var(--color-background-secondary);overflow:hidden">
              <div style="aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;padding:0.75rem">{%- if product.images.size > 1 -%}<img src="{{ product.images[1] | image_url: width: 300 }}" alt="Back" style="max-height:100%;max-width:100%;object-fit:contain">{%- else -%}<span style="color:var(--color-text-muted);font-size:0.75rem;font-style:italic">Back</span>{%- endif -%}</div>
              <div style="padding:0.4rem;text-align:center;font-size:0.5625rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-text-muted);border-top:1px solid var(--color-border)">BACK</div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Config -->
      <div style="position:sticky;top:80px;display:flex;flex-direction:column;gap:0.875rem">
        <div style="border:1px solid var(--color-border);border-radius:var(--radius-card);padding:1.75rem;background:#fff">
          <div style="font-size:0.5625rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:var(--color-primary);margin-bottom:0.5rem">Custom Printed</div>
          <h1 style="font-family:var(--font-heading,serif);font-size:2rem;font-weight:700;color:var(--color-navy);line-height:1.1;margin-bottom:0.75rem">{{ product.title }}</h1>
          {%- if product.description != blank -%}
            <p style="font-size:0.875rem;color:var(--color-text-muted);line-height:1.6;margin-bottom:1rem">{{ product.description | strip_html | truncatewords: 20 }}</p>
          {%- endif -%}
          {%- if product.metafields.custom.material != blank -%}
            <div style="background:var(--color-background-secondary);border-radius:4px;padding:0.875rem 1rem;margin-bottom:1.25rem;font-size:0.75rem;line-height:1.7;color:var(--color-text-muted)">
              <div style="font-weight:700;color:var(--color-text)">{{ product.metafields.custom.material }}</div>
              {%- if product.metafields.custom.material_details != blank -%}<div>{{ product.metafields.custom.material_details }}</div>{%- endif -%}
            </div>
          {%- endif -%}
          <!-- Print technique -->
          <div style="margin-bottom:1.25rem">
            <div style="font-size:0.5625rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.625rem">Print Technique</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem">
              {%- assign tech_str = product.metafields.custom.print_techniques | default: 'HTV Vinyl:+5,DTF Transfer:+8,Sublimation:incompatible,Screen Print:-5' -%}
              {%- assign techs = tech_str | split: ',' -%}
              {%- for t in techs -%}
                {%- assign tp = t | split: ':' -%}
                {%- assign tn = tp[0] | strip -%}
                {%- assign tm = tp[1] | strip -%}
                {%- assign incompat = false -%}{%- if tm == 'incompatible' -%}{%- assign incompat = true -%}{%- endif -%}
                <button class="itb{% if forloop.first %} ita{% endif %}" data-name="{{ tn }}" data-mod="{{ tm }}"
                  {% if incompat %}disabled{% endif %} onclick="inkTech(this)"
                  style="padding:0.625rem 0.75rem;border:1px solid {% if forloop.first %}var(--color-primary){% else %}var(--color-border){% endif %};border-radius:var(--radius-button);background:{% if forloop.first %}rgba(194,110,41,0.07){% else %}#fff{% endif %};text-align:left;cursor:{% if incompat %}default{% else %}pointer{% endif %};opacity:{% if incompat %}0.45{% else %}1{% endif %}">
                  <div style="font-size:0.8125rem;font-weight:600;color:{% if incompat %}var(--color-text-muted){% else %}var(--color-navy){% endif %}">{{ tn }}</div>
                  <div style="font-size:0.75rem;color:{% if incompat %}var(--color-text-muted){% else %}var(--color-primary){% endif %};margin-top:0.1rem">{%- if incompat -%}incompatible{%- elsif tm contains '-' -%}{{ tm }}%{%- else -%}+{{ tm }}%{%- endif -%}</div>
                </button>
              {%- endfor -%}
            </div>
          </div>
          <!-- Price -->
          <div style="margin-bottom:1.25rem">
            <span id="iup" style="font-family:var(--font-heading,serif);font-size:2rem;font-weight:700;color:var(--color-navy)">{{ product.price | money }}</span>
            <span style="font-size:0.875rem;color:var(--color-text-muted);margin-left:0.375rem">per unit</span>
          </div>
          <!-- Garment color -->
          <div style="margin-bottom:1.25rem">
            <div style="font-size:0.5625rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.625rem">Garment Color</div>
            <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.5rem">
              {%- if color_option -%}
                {%- for val in color_option.values -%}
                  <button class="icb{% if forloop.first %} ica{% endif %}" title="{{ val }}" data-label="{{ val }}" onclick="inkColor(this)" style="width:28px;height:28px;border-radius:50%;background:{{ val | handleize }};border:{% if forloop.first %}2.5px solid var(--color-primary){% else %}2px solid rgba(0,0,0,0.12){% endif %};cursor:pointer;padding:0;flex-shrink:0"></button>
                {%- endfor -%}
              {%- else -%}
                {%- assign dcolors = '#1a2038:Navy,#ffffff:White,#c26e29:Amber,#8b5e3c:Brown,#4a6fa5:Blue,#2c4a7c:Dark Blue,#8b7c6a:Tan,#222222:Black' | split: ',' -%}
                {%- for dc in dcolors -%}
                  {%- assign dcp = dc | split: ':' -%}
                  <button class="icb{% if forloop.first %} ica{% endif %}" title="{{ dcp[1] }}" data-label="{{ dcp[1] }}" onclick="inkColor(this)" style="width:28px;height:28px;border-radius:50%;background:{{ dcp[0] }};border:{% if forloop.first %}2.5px solid var(--color-primary){% else %}2px solid rgba(0,0,0,0.12){% endif %};cursor:pointer;padding:0;flex-shrink:0"></button>
                {%- endfor -%}
              {%- endif -%}
            </div>
            <div style="font-size:0.75rem;color:var(--color-text-muted)">Selected: <strong id="iclbl">{{ color_option.values.first | default: 'Navy' }}</strong></div>
          </div>
          <!-- Sizes & Quantities -->
          <div style="margin-bottom:1rem">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.625rem">
              <div style="font-size:0.5625rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-text-muted)">Sizes & Quantities</div>
              <a href="#" style="font-size:0.75rem;color:var(--color-primary);text-decoration:none">Size Guide</a>
            </div>
            <div id="irows">
              <div class="irow" style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem">
                <select onchange="inkCalc()" style="flex:1;padding:0.5rem 0.75rem;border:1px solid var(--color-border);border-radius:var(--radius-button);font-size:0.875rem;font-family:inherit;background:#fff;color:var(--color-text)">
                  {%- if size_option -%}{%- for v in size_option.values -%}<option>{{ v }}</option>{%- endfor -%}{%- else -%}<option>XS</option><option>S</option><option selected>M</option><option>L</option><option>XL</option><option>2XL</option><option>3XL</option>{%- endif -%}
                </select>
                <button type="button" onclick="inkQ(this,-1)" style="width:32px;height:36px;border:1px solid var(--color-border);background:#fff;border-radius:var(--radius-button);cursor:pointer;font-size:1.1rem;color:var(--color-text-muted)">-</button>
                <input type="number" class="iq" min="1" value="1" onchange="inkCalc()" style="width:46px;text-align:center;border:1px solid var(--color-border);border-radius:var(--radius-button);height:36px;font-size:0.9375rem;font-weight:600;font-family:inherit">
                <button type="button" onclick="inkQ(this,1)" style="width:32px;height:36px;border:1px solid var(--color-border);background:#fff;border-radius:var(--radius-button);cursor:pointer;font-size:1.1rem;color:var(--color-text-muted)">+</button>
              </div>
            </div>
            <button onclick="inkMoreSize()" style="width:100%;padding:0.625rem;border:1.5px dashed var(--color-primary);background:transparent;color:var(--color-primary);font-size:0.8125rem;font-weight:600;letter-spacing:0.04em;cursor:pointer;border-radius:var(--radius-button)">+ ADD ANOTHER SIZE</button>
          </div>
          <!-- Summary -->
          <div style="padding:0.875rem 0;border-top:1px solid var(--color-border);margin-bottom:0.875rem">
            <div style="font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:0.625rem">Total: <strong id="itu" style="color:var(--color-text)">1</strong> units</div>
            <div style="display:flex;justify-content:space-between;font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:0.25rem"><span id="ill">HTV Vinyl x 1 units</span><span id="ila">{{ product.price | money }}</span></div>
            <div style="display:flex;justify-content:space-between;font-size:0.8125rem;color:var(--color-primary);margin-bottom:0.75rem"><span>Free digital proof</span><span>$0.00</span></div>
            <div style="display:flex;justify-content:space-between;font-size:1rem;font-weight:700;color:var(--color-navy)"><span>Estimated Total</span><span id="itp">{{ product.price | money }}</span></div>
          </div>
          <!-- CTA -->
          {% form 'product', product %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" id="ifq" value="1">
            <div style="display:flex;flex-direction:column;gap:0.625rem">
              <button type="submit" name="add" {% unless product.available %}disabled{% endunless %} style="width:100%;padding:1rem;background:var(--color-primary);color:#fff;border:none;font-size:0.875rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;border-radius:var(--radius-button)">{%- if product.available -%}ADD TO QUOTE REQUEST{%- else -%}SOLD OUT{%- endif -%}</button>
              <a href="/pages/contact" style="display:block;width:100%;padding:0.9rem;text-align:center;border:1.5px solid var(--color-navy);color:var(--color-navy);background:#fff;font-size:0.875rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;border-radius:var(--radius-button);box-sizing:border-box">REQUEST CUSTOM QUOTE</a>
            </div>
          {% endform %}
        </div>
        <!-- Trust -->
        <div style="border:1px solid var(--color-border);border-radius:var(--radius-card);padding:1.25rem;background:#fff">
          {%- assign ti = 'Free digital proof in 24h,No minimum order,Ships in 3–5 business days,Print-ready files provided' | split: ',' -%}
          {%- for item in ti -%}<div style="display:flex;align-items:center;gap:0.625rem;font-size:0.8125rem;color:var(--color-text-muted);{% unless forloop.last %}margin-bottom:0.5rem{% endunless %}"><span style="color:var(--color-primary);font-weight:700;font-size:1rem">·</span>{{ item }}</div>{%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var base={{ product.price }},tech='HTV Vinyl',mod=0.05,view='front',ups={front:null,back:null};
  function fmt(c){return '$'+(c/100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',');}
  function unit(){return Math.round(base*(1+mod));}
  window.inkTech=function(b){document.querySelectorAll('.itb').forEach(function(x){x.style.border='1px solid var(--color-border)';x.style.background='#fff';});b.style.border='1px solid var(--color-primary)';b.style.background='rgba(194,110,41,0.07)';tech=b.dataset.name;mod=(parseFloat(b.dataset.mod)||0)/100;inkCalc();};
  window.inkColor=function(b){document.querySelectorAll('.icb').forEach(function(x){x.style.border='2px solid rgba(0,0,0,0.12)';});b.style.border='2.5px solid var(--color-primary)';var l=document.getElementById('iclbl');if(l)l.textContent=b.dataset.label||b.title;};
  window.inkQ=function(b,d){var i=b.parentElement.querySelector('.iq');i.value=Math.max(1,(parseInt(i.value)||1)+d);inkCalc();};
  window.inkCalc=function(){var qs=document.querySelectorAll('.iq'),tot=0;qs.forEach(function(q){tot+=parseInt(q.value)||0;});tot=Math.max(1,tot);var u=unit(),s=u*tot;document.getElementById('itu').textContent=tot;document.getElementById('ifq').value=tot;document.getElementById('iup').textContent=fmt(u);document.getElementById('ill').textContent=tech+' x '+tot+' units';document.getElementById('ila').textContent=fmt(s);document.getElementById('itp').textContent=fmt(s);};
  window.inkMoreSize=function(){var c=document.getElementById('irows'),n=c.querySelector('.irow').cloneNode(true);n.querySelector('.iq').value=1;c.appendChild(n);inkCalc();};
  window.inkView=function(v){view=v;var fb=document.getElementById('btn-front'),bb=document.getElementById('btn-back'),vf=document.getElementById('vf'),vb2=document.getElementById('vb');fb.style.background=v==='front'?'var(--color-navy)':'#fff';fb.style.color=v==='front'?'#fff':'var(--color-text-muted)';bb.style.background=v==='back'?'var(--color-navy)':'#fff';bb.style.color=v==='back'?'#fff':'var(--color-text-muted)';vf.style.border=v==='front'?'2px solid var(--color-primary)':'1px solid var(--color-border)';vb2.style.border=v==='back'?'2px solid var(--color-primary)':'1px solid var(--color-border)';var img=document.getElementById('ink-img');if(img&&img.tagName==='IMG'){if(v==='back'&&ups.back)img.src=ups.back;else if(v==='front'&&ups.front)img.src=ups.front;}};
  window.inkHandleUpload=function(input){if(!input.files[0])return;var r=new FileReader();r.onload=function(e){ups[view]=e.target.result;var img=document.getElementById('ink-img');if(img&&img.tagName==='IMG')img.src=e.target.result;var p=document.getElementById('ink-prompt');if(p)p.style.display='none';};r.readAsDataURL(input.files[0]);};
  window.inkAddText=function(){var p=document.getElementById('ink-text-popup');if(p){p.style.display='flex';document.getElementById('ink-text-inp').focus();}};
  window.inkConfirmText=function(){var v=document.getElementById('ink-text-inp').value.trim();if(v){var d=document.getElementById('ink-text-disp');d.textContent=v;d.style.display='block';var p=document.getElementById('ink-prompt');if(p)p.style.display='none';}document.getElementById('ink-text-popup').style.display='none';document.getElementById('ink-text-inp').value='';};
  window.inkToggleColor=function(){};window.inkUndo=function(){};window.inkRedo=function(){};
  window.inkClear=function(){ups={front:null,back:null};var img=document.getElementById('ink-img');if(img&&img.tagName==='IMG')img.src='{{ product.featured_image | image_url: width: 700 }}';var d=document.getElementById('ink-text-disp');if(d){d.textContent='';d.style.display='none';}var p=document.getElementById('ink-prompt');if(p)p.style.display='block';document.getElementById('ink-upload').value='';};
  window.inkDownload=function(){var img=document.getElementById('ink-img');if(!img||img.tagName!=='IMG')return;var a=document.createElement('a');a.href=img.src;a.download='{{ product.handle }}-preview.jpg';a.click();};
})();
</script>

