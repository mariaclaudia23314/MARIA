{% comment %}Inkcora — sections/main-product.liquid{% endcomment %}
<section class="section" id="MainProduct-{{ section.id }}">
  <div class="page-width">
    {%- assign product = product -%}
    <div class="grid grid--2" style="gap:3rem;align-items:start">
      {%- comment -%} Media {%- endcomment -%}
      <div>
        {%- if product.featured_image -%}
          <div style="border-radius:var(--radius-card);overflow:hidden;border:1px solid var(--color-border);margin-bottom:1rem">
            {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'eager', style: 'width:100%;aspect-ratio:4/5;object-fit:cover' }}
          </div>
        {%- else -%}
          <div style="background:var(--color-background-secondary);aspect-ratio:4/5;border-radius:var(--radius-card);display:flex;align-items:center;justify-content:center;border:1px solid var(--color-border)">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
        {%- if product.images.size > 1 -%}
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.5rem">
            {%- for image in product.images limit: 4 -%}
              <div style="border-radius:var(--radius-card);overflow:hidden;border:1px solid var(--color-border);cursor:pointer">
                {{ image | image_url: width: 200 | image_tag: loading: 'lazy', style: 'width:100%;aspect-ratio:1/1;object-fit:cover' }}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Info {%- endcomment -%}
      <div style="position:sticky;top:88px">
        <div style="font-size:0.625rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-primary);margin-bottom:0.5rem">Custom Printed</div>
        <h1 class="h2" style="margin-bottom:0.5rem">{{ product.title }}</h1>
        {%- if product.metafields.custom.material != blank -%}
          <div style="background:var(--color-background-secondary);border-radius:3px;padding:0.75rem 1rem;margin-bottom:1rem;font-size:0.75rem;color:var(--color-text-muted)">{{ product.metafields.custom.material }}</div>
        {%- endif -%}
        <div style="font-size:2rem;font-weight:600;color:var(--color-primary);margin-bottom:1rem;font-family:var(--font-heading)">
          {{ product.price | money }}
          <span style="font-size:0.875rem;font-weight:400;color:var(--color-text-muted)">per unit</span>
        </div>
        <div class="divider" style="margin-bottom:1.25rem"></div>

        {%- comment -%} Product form {%- endcomment -%}
        {% form 'product', product %}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div style="margin-bottom:1.25rem">
                <div style="font-size:0.625rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.625rem">{{ option.name }}</div>
                <div style="display:flex;gap:0.375rem;flex-wrap:wrap">
                  {%- for value in option.values -%}
                    <label style="display:contents">
                      <input type="radio" name="{{ option.name }}" value="{{ value }}" style="display:none" {%- if option.selected_value == value -%} checked{%- endif -%}>
                      <span class="variant-pill {% if option.selected_value == value %}active{% endif %}" onclick="this.previousSibling.checked=true;document.querySelectorAll('.variant-pill').forEach(p=>p.classList.remove('active'));this.classList.add('active')">{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {%- comment -%} Quantity {%- endcomment -%}
          <div style="margin-bottom:1.25rem">
            <div style="font-size:0.625rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.625rem">Quantity</div>
            <div style="display:flex;border:1px solid var(--color-border);border-radius:var(--radius-button);overflow:hidden;width:fit-content">
              <button type="button" onclick="this.nextSibling.stepDown()" style="width:40px;height:44px;border:none;background:white;cursor:pointer;font-size:1.2rem;color:var(--color-text-muted);border-right:1px solid var(--color-border)">-</button>
              <input type="number" name="quantity" id="Quantity-{{ section.id }}" min="1" value="12" style="width:56px;text-align:center;border:none;font-size:1rem;font-weight:600;font-family:inherit">
              <button type="button" onclick="this.previousSibling.stepUp()" style="width:40px;height:44px;border:none;background:white;cursor:pointer;font-size:1.2rem;color:var(--color-text-muted);border-left:1px solid var(--color-border)">+</button>
            </div>
          </div>

          <div style="display:flex;flex-direction:column;gap:0.625rem">
            <button type="submit" name="add" class="btn btn--primary btn--full" {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}Add to Quote Request{%- else -%}Sold Out{%- endif -%}
            </button>
            <a href="/pages/contact" class="btn btn--secondary btn--full">Request Custom Quote</a>
          </div>
        {% endform %}

        <div class="divider" style="margin:1.25rem 0"></div>

        {%- comment -%} Trust badges {%- endcomment -%}
        {%- assign trust_items = 'Free digital proof in 24h,No minimum order quantity,Ships in 3–5 business days,Print-ready files provided' | split: ',' -%}
        <div style="display:flex;flex-direction:column;gap:0.5rem">
          {%- for item in trust_items -%}
            <div style="display:flex;align-items:center;gap:0.625rem;font-size:0.75rem;color:var(--color-text-muted)">
              <div style="width:4px;height:4px;border-radius:50%;background:var(--color-primary);flex-shrink:0"></div>
              {{ item }}
            </div>
          {%- endfor -%}
        </div>

        {%- if product.description != blank -%}
          <div class="divider" style="margin:1.25rem 0"></div>
          <div style="font-size:0.9375rem;color:var(--color-text-muted);line-height:1.75">{{ product.description }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Producto principal",
  "tag": "section",
  "settings": []
}
{% endschema %}
