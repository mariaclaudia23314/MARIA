{% comment %}Inkcora — sections/featured-products.liquid{% endcomment %}
<section class="section {% if section.settings.color_scheme == 'dark' %}section--dark{% elsif section.settings.color_scheme == 'secondary' %}section--secondary{% endif %}">
  <div class="page-width">
    {%- if section.settings.title != blank or section.settings.tag != blank -%}
      <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem;margin-bottom:3rem">
        <div>
          {%- if section.settings.tag != blank -%}
            <div class="section-tag {% if section.settings.color_scheme == 'dark' %}section-tag--light{% endif %}">{{ section.settings.tag }}</div>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="h2" {% if section.settings.color_scheme == 'dark' %}style="color:#fff"{% endif %}>{{ section.settings.title }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.view_all_label != blank -%}
          <a href="{{ section.settings.view_all_url | default: routes.all_products_collection_url }}" style="font-size:0.8125rem;font-weight:600;color:var(--color-primary);border-bottom:1.5px solid var(--color-primary);padding-bottom:2px">{{ section.settings.view_all_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid grid--{{ section.settings.columns_desktop }} grid--auto">
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- assign ph_titles  = "Classic Tee,Pullover Hoodie,Snapback Hat,Canvas Tote" | split: "," -%}
        {%- assign ph_prices  = "from $22.99,from $38.99,from $22.99,from $14.99" | split: "," -%}
        {%- assign ph_methods = "Sublimation · HTV,HTV · Screen Print,HTV · Embroidery,Screen Print · HTV" | split: "," -%}
        {%- assign ph_labels  = "Classic Tee — product photo,Pullover Hoodie — product photo,Snapback Hat — product photo,Canvas Tote — product photo" | split: "," -%}
        {%- assign ph_colors  = "fff,111827,c0392b,2563eb|111827,9ca3af,ffffff|111827,c0392b,ffffff|b5a07a,ffffff,111827" | split: "|" -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign ph_title  = ph_titles[idx] -%}
          {%- assign ph_price  = ph_prices[idx] -%}
          {%- assign ph_method = ph_methods[idx] -%}
          {%- assign ph_label  = ph_labels[idx] -%}
          {%- assign ph_color  = ph_colors[idx] | split: "," -%}
          <div class="product-card" style="display:flex;flex-direction:column">
            <div style="position:relative;border-radius:var(--radius-card,4px);overflow:hidden;aspect-ratio:4/5;background-image:repeating-linear-gradient(135deg,#ddd8cf 0px,#ddd8cf 1px,#e8e3d9 1px,#e8e3d9 20px);display:flex;align-items:center;justify-content:center">
              <span style="background:rgba(255,255,255,0.55);padding:0.375rem 0.875rem;font-size:0.6875rem;color:var(--color-text-muted);font-style:italic;border-radius:2px">{{ ph_label }}</span>
            </div>
            <div style="padding:0.875rem 0 0;flex:1;display:flex;flex-direction:column;gap:0.3rem">
              <div style="display:flex;justify-content:space-between;align-items:baseline;gap:0.5rem">
                <span style="font-size:0.9375rem;font-weight:600;color:var(--color-navy)">{{ ph_title }}</span>
                <span style="font-size:0.9375rem;font-weight:500;color:var(--color-navy);white-space:nowrap;flex-shrink:0">{{ ph_price }}</span>
              </div>
              <div style="font-size:0.75rem;color:#6b9ec7;font-weight:500">{{ ph_method }}</div>
              <div style="display:flex;align-items:center;gap:0.3rem;margin-top:0.25rem;flex-wrap:wrap">
                {%- for swatch in ph_color -%}
                  <div style="width:14px;height:14px;border-radius:50%;background:#{{ swatch }};border:1.5px solid {% if swatch == 'ffffff' %}#e5e7eb{% else %}transparent{% endif %};flex-shrink:0"></div>
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Productos destacados",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "tag", "label": "Etiqueta de sección" },
    { "type": "text", "id": "title", "label": "Título", "default": "Custom Apparel & Accessories" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 2, "default": 4, "label": "Productos a mostrar" },
    { "type": "select", "id": "columns_desktop", "label": "Columnas (desktop)", "options": [{"value":"3","label":"3"},{"value":"4","label":"4"}], "default": "4" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de color", "options": [{"value":"white","label":"Blanco"},{"value":"secondary","label":"Fondo secundario"},{"value":"dark","label":"Oscuro"}], "default": "white" },
    { "type": "text", "id": "view_all_label", "label": "Texto 'Ver todo'", "default": "View All Products" },
    { "type": "url", "id": "view_all_url", "label": "Enlace 'Ver todo'" }
  ],
  "presets": [{ "name": "Productos destacados" }]
}
{% endschema %}

