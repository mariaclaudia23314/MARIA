{% comment %}Inkcora — sections/stats.liquid{% endcomment %}
<section class="section" style="padding:3rem 0;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);background:var(--color-background)">
  <div class="page-width">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);text-align:center;gap:2rem">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <div style="font-family:var(--font-heading,serif);font-size:clamp(2rem,4vw,3rem);font-weight:700;color:var(--color-navy);line-height:1">{{ block.settings.number }}</div>
          <div style="font-size:0.625rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-text-muted);margin-top:0.5rem">{{ block.settings.label }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Estadísticas",
  "tag": "section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "stat",
      "name": "Estadística",
      "settings": [
        { "type": "text", "id": "number", "label": "Número", "default": "500+" },
        { "type": "text", "id": "label",  "label": "Etiqueta", "default": "Brands Served" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Estadísticas",
      "blocks": [
        { "type": "stat", "settings": { "number": "500+", "label": "Brands Served" } },
        { "type": "stat", "settings": { "number": "4", "label": "Print Technologies" } },
        { "type": "stat", "settings": { "number": "3-5 Days", "label": "Avg. Turnaround" } },
        { "type": "stat", "settings": { "number": "24h", "label": "Free Proof Delivery" } }
      ]
    }
  ]
}
{% endschema %}
