{% comment %}Inkcora — sections/main-password.liquid{% endcomment %}
<div style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--color-navy);padding:2rem;text-align:center">
  <div style="font-family:var(--font-heading);font-size:1.75rem;font-weight:700;color:white;margin-bottom:0.5rem">{{ shop.name }}</div>
  <p style="color:rgba(255,255,255,0.6);margin-bottom:2.5rem;font-size:0.9375rem">{{ section.settings.message }}</p>
  {%- form 'storefront_password' -%}
    <div style="display:flex;gap:0.75rem;max-width:400px">
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Password" class="field__input" style="flex:1">
      <button type="submit" class="btn btn--primary">Enter</button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Página de contraseña", "settings": [{ "type": "textarea", "id": "message", "label": "Mensaje", "default": "Opening soon. Enter your password to access." }] }
{% endschema %}
