{% comment %}Inkcora — sections/main-cart.liquid{% endcomment %}
<section class="section">
  <div class="page-width">
    <h1 class="h2" style="margin-bottom:2rem">Your Quote Request</h1>
    {%- if cart.item_count > 0 -%}
      <div style="display:grid;grid-template-columns:1fr 360px;gap:2rem;align-items:start">
        <div>
          {%- for item in cart.items -%}
            <div style="display:flex;gap:1rem;padding:1.25rem 0;border-bottom:1px solid var(--color-border);align-items:center">
              <div style="width:80px;height:80px;border-radius:var(--radius-card);overflow:hidden;border:1px solid var(--color-border);flex-shrink:0">
                {{ item.image | image_url: width: 160 | image_tag: style: 'width:100%;height:100%;object-fit:cover' }}
              </div>
              <div style="flex:1">
                <div style="font-weight:500;margin-bottom:4px">{{ item.product.title }}</div>
                <div style="font-size:0.8125rem;color:var(--color-text-muted)">{{ item.variant.title }}</div>
                <div style="font-size:0.875rem;font-weight:600;color:var(--color-primary);margin-top:4px">{{ item.price | money }}</div>
              </div>
              <a href="{{ item.url_to_remove }}" style="font-size:0.75rem;color:var(--color-text-muted);text-decoration:underline">Remove</a>
            </div>
          {%- endfor -%}
        </div>
        <div style="background:var(--color-background-secondary);border-radius:var(--radius-card);padding:1.5rem;border:1px solid var(--color-border)">
          <div style="font-size:0.625rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:1rem">Order Summary</div>
          <div style="display:flex;justify-content:space-between;font-size:0.9375rem;margin-bottom:0.5rem">
            <span>Subtotal</span><span style="font-weight:600">{{ cart.total_price | money }}</span>
          </div>
          <div style="font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:1.25rem">Final pricing confirmed in your free quote within 24 hours.</div>
          <a href="/pages/contact" class="btn btn--primary btn--full" style="margin-bottom:0.75rem">Request Custom Quote</a>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--secondary btn--full">Continue Shopping</a>
        </div>
      </div>
    {%- else -%}
      <div style="text-align:center;padding:4rem 0">
        <p style="font-size:1.125rem;color:var(--color-text-muted);margin-bottom:1.5rem">Your quote request is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Browse Products</a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Carrito principal", "tag": "section", "settings": [] }
{% endschema %}
