{% comment %}Inkcora — sections/main-blog.liquid{% endcomment %}
<section class="section">
  <div class="page-width">
    <h1 class="h2" style="margin-bottom:3rem">{{ blog.title }}</h1>
    {%- paginate blog.articles by 6 -%}
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <article style="border:1px solid var(--color-border);border-radius:var(--radius-card);overflow:hidden;transition:box-shadow 0.2s" onmouseover="this.style.boxShadow='0 8px 24px rgba(0,0,0,0.08)'" onmouseout="this.style.boxShadow='none'">
          {%- if article.image -%}
            <a href="{{ article.url }}">{{ article.image | image_url: width: 600 | image_tag: style: 'width:100%;aspect-ratio:16/9;object-fit:cover' }}</a>
          {%- else -%}
            <div style="background:var(--color-background-secondary);aspect-ratio:16/9">{{ 'image' | placeholder_svg_tag }}</div>
          {%- endif -%}
          <div style="padding:1.5rem">
            {%- if article.tags.size > 0 -%}
              <div style="font-size:0.625rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-primary);margin-bottom:0.5rem">{{ article.tags | first }}</div>
            {%- endif -%}
            <h2 style="font-family:var(--font-heading);font-size:1.25rem;font-weight:600;line-height:1.3;margin-bottom:0.75rem"><a href="{{ article.url }}" style="color:var(--color-text)">{{ article.title }}</a></h2>
            <p style="font-size:0.875rem;color:var(--color-text-muted);line-height:1.65;margin-bottom:1rem">{{ article.excerpt | strip_html | truncate: 120 }}</p>
            <a href="{{ article.url }}" style="font-size:0.8125rem;font-weight:600;color:var(--color-primary);border-bottom:1px solid var(--color-primary);padding-bottom:1px">Read more</a>
          </div>
        </article>
      {%- else -%}
        <p style="color:var(--color-text-muted)">No articles yet.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div style="display:flex;justify-content:center;gap:0.5rem;margin-top:3rem">{{ paginate | default_pagination }}</div>
    {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Blog principal", "tag": "section", "settings": [] }
{% endschema %}
