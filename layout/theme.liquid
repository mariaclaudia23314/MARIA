{% comment %}Inkcora Theme — layout/theme.liquid — Shopify OS 2.0{% endcomment %}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  {%- if canonical_url != blank -%}
    <link rel="canonical" href="{{ canonical_url }}">
  {%- endif -%}

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}

  <!-- Title & Meta -->
  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:description" content="{{ page_description | default: shop.description | strip_html | escape }}">
  {%- if page_image -%}
    <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
  {%- endif -%}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">

  <!-- Schema.org: LocalBusiness -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "telephone": {{ settings.store_phone | json }},
    "email": "hello@inkcora.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Beverly",
      "addressRegion": "MA",
      "postalCode": "01915",
      "addressCountry": "US"
    },
    "priceRange": "$$",
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "09:00",
      "closes": "18:00"
    }]
  }
  </script>

  <!-- Font preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Theme font faces -->
  {%- if settings.type_heading_font.family != blank -%}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if settings.type_body_font.family != blank -%}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  <!-- Theme CSS -->
  {{ 'base.css' | asset_url | stylesheet_tag }}

  <!-- CSS Custom Properties from Theme Settings -->
  <style>
    :root {
      --color-primary:    {{ settings.color_primary }};
      --color-primary-hover: {{ settings.color_primary | color_darken: 10 }};
      --color-navy:       {{ settings.color_navy }};
      --color-navy-mid:   {{ settings.color_navy | color_lighten: 6 }};
      --color-navy-dark:  {{ settings.color_navy | color_darken: 12 }};
      --color-background: {{ settings.color_background }};
      --color-background-secondary: {{ settings.color_background_secondary }};
      --color-text:       {{ settings.color_text }};
      --color-text-muted: {{ settings.color_text_muted }};
      --color-border:     {{ settings.color_border }};
      --color-accent-text:{{ settings.color_primary | color_darken: 20 }};
      --font-heading:     {{ settings.type_heading_font.family | default: 'Cormorant Garamond' }}, {{ settings.type_heading_font.fallback_families | default: 'Georgia, serif' }};
      --font-body:        {{ settings.type_body_font.family | default: 'DM Sans' }}, {{ settings.type_body_font.fallback_families | default: 'Arial, sans-serif' }};
      --radius-button:    {{ settings.button_border_radius }}px;
      --radius-card:      {{ settings.card_border_radius }}px;
      --page-width:       {{ settings.page_width }}px;
      --spacing-sections: {{ settings.spacing_sections }}px;
      --swatch-size:      {{ settings.swatch_size }}px;
      --drawer-width:     {{ settings.drawer_width }}px;
    }
    {% if settings.button_uppercase == false %}
      .btn, .button { text-transform: none; letter-spacing: 0.02em; }
    {% endif %}
    {% if settings.custom_css != blank %}
      {{ settings.custom_css }}
    {% endif %}
  </style>

  <!-- Content for Shopify apps (eg: analytics, apps) -->
  {{ content_for_header }}
</head>

<body class="template-{{ template.name }}{% if settings.animations_hover_elements != 'none' %} animate--{{ settings.animations_hover_elements }}{% endif %}">
  <a class="skip-to-content-link btn btn--primary visually-hidden" href="#MainContent">
    Skip to content
  </a>

  {%- sections 'header-group' -%}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- sections 'footer-group' -%}

  <!-- Scripts -->
  {{ 'global.js' | asset_url | script_tag }}
  {{ 'theme.js' | asset_url | script_tag }}

</body>
</html>
