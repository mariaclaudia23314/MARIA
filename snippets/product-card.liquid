{% comment %}Inkcora — snippets/product-card.liquid{% endcomment %}
{%- liquid
  assign badge_text = ''
  if product.metafields.custom.badge != blank
    assign badge_text = product.metafields.custom.badge
  elsif product.tags contains 'best-seller'
    assign badge_text = 'Best Seller'
  elsif product.tags contains 'new'
    assign badge_text = 'New'
  elsif product.tags contains 'corporate'
    assign badge_text = 'Corporate'
  elsif product.tags contains 'popular'
    assign badge_text = 'Popular'
  endif

  assign print_methods = product.metafields.custom.print_methods
  assign material      = product.metafields.custom.material
  assign color_option  = product.options_by_name['Color'] | default: product.options_by_name['Colour']
  assign swatch_limit  = 6
-%}

<div class="product-card" style="display:flex;flex-direction:column">
  {%- comment -%} Image + badge {%- endcomment -%}
  <a href="{{ product.url }}" style="display:block;position:relative;text-decoration:none;overflow:hidden;border-radius:var(--radius-card,4px);background:var(--color-background-secondary);flex-shrink:0">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'width:100%;aspect-ratio:1/1;object-fit:cover;display:block', alt: product.featured_image.alt | default: product.title }}
    {%- else -%}
      <div style="aspect-ratio:1/1;display:flex;align-items:center;justify-content:center">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {%- endif -%}

    {%- if badge_text != blank -%}
      <span style="position:absolute;top:0.625rem;left:0.625rem;background:var(--color-navy);color:#fff;font-size:0.5625rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:0.25rem 0.625rem;border-radius:2px">{{ badge_text }}</span>
    {%- endif -%}
  </a>

  {%- comment -%} Info {%- endcomment -%}
  <div style="padding:0.875rem 0 0;flex:1;display:flex;flex-direction:column;gap:0.3rem">

    {%- comment -%} Title + price {%- endcomment -%}
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:0.5rem">
      <a href="{{ product.url }}" style="font-size:0.9375rem;font-weight:600;color:var(--color-navy);text-decoration:none;line-height:1.3">{{ product.title }}</a>
      <span style="font-size:0.9375rem;font-weight:500;color:var(--color-navy);white-space:nowrap;flex-shrink:0">
        {%- if product.price_varies -%}from {%- endif -%}{{ product.price_min | money }}
      </span>
    </div>

    {%- comment -%} Short description {%- endcomment -%}
    {%- if product.metafields.custom.subtitle != blank -%}
      <p style="font-size:0.8rem;color:var(--color-text-muted);line-height:1.4;margin:0">{{ product.metafields.custom.subtitle }}</p>
    {%- elsif product.description != blank -%}
      <p style="font-size:0.8rem;color:var(--color-text-muted);line-height:1.4;margin:0">{{ product.description | strip_html | truncatewords: 8 }}</p>
    {%- endif -%}

    {%- comment -%} Print methods + material {%- endcomment -%}
    {%- if print_methods != blank or material != blank -%}
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:0.125rem">
        {%- if print_methods != blank -%}
          <span style="font-size:0.625rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-primary)">{{ print_methods }}</span>
        {%- else -%}
          <span></span>
        {%- endif -%}
        {%- if material != blank -%}
          <span style="font-size:0.625rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-text-muted)">{{ material }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Color swatches {%- endcomment -%}
    {%- if color_option and settings.card_show_color_swatches -%}
      <div style="display:flex;align-items:center;gap:0.25rem;margin-top:0.25rem;flex-wrap:wrap">
        {%- for value in color_option.values limit: swatch_limit -%}
          {%- assign color_handle = value | handleize -%}
          <div title="{{ value }}" style="width:14px;height:14px;border-radius:50%;background:{{ color_handle }};border:1.5px solid {{ color_handle | replace: 'white', '#e5e7eb' | replace: 'ivory', '#e5e7eb' | replace: 'cream', '#e5e7eb' }};flex-shrink:0"></div>
        {%- endfor -%}
        {%- if color_option.values.size > swatch_limit -%}
          <span style="font-size:0.625rem;color:var(--color-text-muted);font-weight:600">+{{ color_option.values.size | minus: swatch_limit }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>
